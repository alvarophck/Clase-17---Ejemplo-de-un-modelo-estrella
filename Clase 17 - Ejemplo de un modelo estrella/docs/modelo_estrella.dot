 p [pos="8,2!" label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2A2F38" bgcolor="#181B21"><tr><td bgcolor="#1d2430"><font color="#5B9BD5"><b>gold.dim_products</b></font></td></tr><tr><td align="left">product_key (PK)</td></tr><tr><td align="left">product_id · product_number</td></tr><tr><td align="left">product_name · category_id</td></tr><tr><td align="left">category · subcategory · maintenance</td></tr><tr><td align="left">cost · product_line · start_date</td></tr></table>>];
 c -- f [headlabel="N" taillabel="1" fontcolor="#8B929C"]; f -- p [taillabel="N" headlabel="1" fontcolor="#8B929C"];
