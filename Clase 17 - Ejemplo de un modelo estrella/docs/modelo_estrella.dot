 edge [color="#5B9BD5" penwidth=1.2];
 f [pos="4,2!" label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#5B9BD5" bgcolor="#181B21"><tr><td bgcolor="#1d2430"><font color="#5B9BD5"><b>gold.fact_sales</b></font></td></tr><tr><td align="left">order_number</td></tr><tr><td align="left">product_key (FK)</td></tr><tr><td align="left">customer_key (FK)</td></tr><tr><td align="left">order_date · shipping_date · due_date</td></tr><tr><td align="left">sales_amount · quantity · price</td></tr></table>>];
